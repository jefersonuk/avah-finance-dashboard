# Valores aplicados por cima do .env.example do SupoClip (setup.sh faz o merge).
# Modo 100% local: nenhuma chave de API paga.

# Transcrição local com openai-whisper.
# tiny/base/small/medium/large-v3: maior = mais preciso e mais lento (CPU).
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=small
# Idioma falado nos vídeos. Vazio = detectar automaticamente (necessário para
# vídeos em vários idiomas; a detecção pode errar em trechos curtos ou ruidosos).
TRANSCRIPTION_LANGUAGE=pt

# LLM local via Ollama. LLM, OLLAMA_BASE_URL e COMPOSE_PROFILES são escritos pelo
# setup.sh conforme o modo: app nativo do host (host.docker.internal, apelido
# supoclip-qwen3 com contexto de 16k) ou container "ollama" (COMPOSE_PROFILES=ollama).
RERANK_LLM=
OLLAMA_API_KEY=
OLLAMA_CONTEXT_LENGTH=16384
# LLM em CPU é lento: uma análise pode passar dos 600 s padrão do app
# (por pedido HTTP e no total). Exige patches/llm-timeouts.patch.
TRANSCRIPT_ANALYSIS_TIMEOUT_SECONDS=3600
ANALYSIS_TOTAL_TIMEOUT_SECONDS=7200
RERANK_TIMEOUT_SECONDS=1800

# Sem chaves de provedores pagos.
ASSEMBLY_AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=

# BACKEND_CPU_ONLY e BACKEND_PLATFORM também vêm do setup.sh: imagem só-CPU e,
# no Apple Silicon, linux/arm64 (sem emulação).

FRONTEND_PORT=3107
NEXT_PUBLIC_APP_URL=http://localhost:3107
BETTER_AUTH_URL=http://localhost:3107
SELF_HOST=true
